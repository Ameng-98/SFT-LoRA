{
  "model": {
    "path": "Qwen/Qwen2.5-1.5B-Instruct",
    "trust_remote_code": true,
    "dtype": "auto",
    "attn_implementation": "sdpa"
  },
  "data": {
    "path": "./dataset/train.json",
    "eval_path": null,
    "split": "train",
    "format": "alpaca",
    "fields": {
      "instruction": "instruction",
      "input": "input",
      "output": "output"
    },
    "system_prompt": "",
    "max_samples": 0,
    "shuffle_seed": 42,
    "num_proc": 1
  },
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.1,
    "target_modules": "auto",
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "training": {
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "num_train_epochs": 3,
    "max_steps": -1,
    "learning_rate": 0.0001,
    "lr_scheduler_type": "cosine",
    "warmup_steps": 5,
    "max_grad_norm": 0.3,
    "logging_steps": 10,
    "save_strategy": "epoch",
    "save_total_limit": 3,
    "max_length": 512,
    "dataset_text_field": "text",
    "gradient_checkpointing": false,
    "packing": false,
    "dataloader_num_workers": 0,
    "dataloader_pin_memory": true,
    "bf16": true,
    "fp16": false,
    "seed": 42,
    "report_to": "none"
  },
  "output": {
    "dir": "./output/lora_adapter",
    "save_final": true,
    "summary_file": "training_summary.json",
    "run_config_file": "run_config.json"
  }
}

{
  "model": {
    "path": "Qwen/Qwen2.5-1.5B-Instruct",
    "trust_remote_code": true,
    "dtype": "float32",
    "attn_implementation": null
  },
  "data": {
    "path": "./dataset/train.json",
    "split": "train",
    "format": "alpaca",
    "fields": {
      "instruction": "instruction",
      "input": "input",
      "output": "output"
    },
    "max_samples": 50,
    "shuffle_seed": 42,
    "num_proc": 1
  },
  "lora": {
    "r": 8,
    "alpha": 16,
    "dropout": 0.05,
    "target_modules": "auto",
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },
  "training": {
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "num_train_epochs": 1,
    "max_steps": -1,
    "learning_rate": 0.0001,
    "lr_scheduler_type": "cosine",
    "warmup_steps": 2,
    "max_grad_norm": 0.3,
    "logging_steps": 1,
    "save_strategy": "no",
    "save_total_limit": 1,
    "max_length": 256,
    "dataset_text_field": "text",
    "gradient_checkpointing": false,
    "packing": false,
    "dataloader_num_workers": 0,
    "dataloader_pin_memory": false,
    "bf16": false,
    "fp16": false,
    "seed": 42,
    "report_to": "none",
    "use_cpu": true
  },
  "output": {
    "dir": "./output/lora_adapter_cpu_smoke",
    "save_final": true,
    "summary_file": "training_summary.json",
    "run_config_file": "run_config.json"
  }
}
